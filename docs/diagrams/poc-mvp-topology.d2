direction: down

router: "Router OpenWrt\n192.168.1.1" {
  shape: cloud
}

galaxia: "Red GalaxIA\n192.168.1.0/24" {
  bastion: "Bastion\n192.168.1.139 · x86_64" {
    atlas: "fhs-atlas\n4001 / 8081"
    navigator: "fhs-navigator\n4010 / 8090"
    star: "fhs-star\n4002"
    llama: "llama.cpp · host\n43110"
