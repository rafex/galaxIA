  }

  portal_pi: "Raspi3B portal-pi\n192.168.1.181 · aarch64" {
    kb: "fhs-kb-provider\n4006 · Podman"
    rag: "fhs-rag-provider\n4005 · Podman"
  }

  thinkpad: "ThinkPad\n192.168.1.239 · x86_64" {
