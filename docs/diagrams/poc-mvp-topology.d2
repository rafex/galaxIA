  }
}

mac: "Mac\n192.168.1.102 · arm64\nnavegador solamente" {
  shape: person
}

router -> galaxia: red soberana
mac -> thinkpad.portal: descarga del Portal HTTPS
mac -> bastion.atlas: TLS/WSS bootstrap
mac -> bastion.navigator: stream FHS directo
bastion.navigator -> ocr.service: tool.call OCR
bastion.navigator -> portal_pi.kb: document.query KB
bastion.navigator -> portal_pi.rag: document.query RAG
