{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rafex/galaxIA/idl/schemas/beacon-satellite.schema.json",
  "title": "FHS Beacon — Satellite",
  "description": "Manifiesto Beacon para nodos de tipo Satellite (proveedor de herramientas/tools). Extiende beacon-base.schema.json.",
  "allOf": [
    { "$ref": "beacon-base.schema.json" },
    {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "provider": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["satellite"],
              "description": "Un Satellite solo puede declararse como tipo 'satellite'."
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "description": "Lista de capacidades/herramientas que expone este Satellite.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificador único de la capability en este Satellite (ej. 'ocr.extract')."
              },
              "name": {
                "type": "string",
                "description": "Nombre legible de la capability."
              },
              "description": {
                "type": "string",
                "description": "Descripción de lo que hace la capability para el LLM."
              },
              "inputMediaTypes": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Media types aceptados como entrada (ej. ['image/png', 'image/jpeg'])."
              },
              "outputMediaTypes": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Media types que produce como salida (ej. ['text/plain', 'application/json'])."
              },
              "languages": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Idiomas soportados por la capability (BCP-47)."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
