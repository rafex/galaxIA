{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rafex/galaxIA/idl/schemas/beacon-star.schema.json",
  "title": "FHS Beacon — Star",
  "description": "Manifiesto Beacon para nodos de tipo Star (proveedor de LLM). Extiende beacon-base.schema.json.",
  "allOf": [
    { "$ref": "beacon-base.schema.json" },
    {
      "type": "object",
      "required": ["models"],
      "properties": {
        "provider": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["star"],
              "description": "Un Star solo puede declararse como tipo 'star'."
            }
          }
        },
        "privacy": {
          "type": "object",
          "required": ["retention", "trainingUse"],
          "properties": {
            "trainingUse": {
              "type": "boolean",
              "description": "true si las conversaciones pueden usarse para fine-tuning del modelo."
            }
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "description": "Lista de modelos LLM disponibles en este Star.",
          "items": {
            "type": "object",
            "required": ["id", "displayName", "capabilities"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificador interno del modelo (ej. 'llama3.2:3b')."
              },
              "displayName": {
                "type": "string",
                "description": "Nombre legible para mostrar en la UI (ej. 'Llama 3.2 3B')."
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["chat", "completion", "embedding", "vision", "tool_calling"]
                },
                "description": "Capacidades que ofrece el modelo."
              },
              "contextWindow": {
                "type": "integer",
                "minimum": 1,
                "description": "Tamaño máximo del contexto en tokens."
              },
              "languages": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Idiomas en que el modelo está entrenado (BCP-47, ej. ['es', 'en'])."
              },
              "toolCalling": {
                "type": "boolean",
                "description": "true si el modelo soporta llamadas a tools (function calling nativo)."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
